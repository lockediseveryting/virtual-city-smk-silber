# Salin jadi .env (opsional — semua boleh dibiarkan kosong, aplikasi tetap jalan).
#   cp .env.example .env

# ---- Dasar ----
APP_PORT=8080
SITE_URL=
# Kosong = dibuat otomatis saat pertama start dan disimpan di volume data
APP_KEY=
# auto_approve | manual
REGISTRATION_MODE=

# ---- Akun admin pertama (ROOT) ----
# Kosong = username "admin" + password acak (lihat: docker compose logs web)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Akun pemilik (moderasi chat, media, tema). Kosong = sama dengan ADMIN_USERNAME
OWNER_USERNAME=

# ---- Anti-DDoS (mod_evasive) ----
# on | off
ANTI_DDOS=on
DDOS_PAGE_PER_SEC=
DDOS_SITE_PER_SEC=
DDOS_BLOCK_SECONDS=
# IP reverse proxy tepercaya (Cloudflare/nginx di depan), pisahkan koma
TRUSTED_PROXIES=

# ---- Web Push (opsional) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Telegram (opsional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ROOT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BANNER_URL=
BACKUP_TELEGRAM_CHAT=

# ---- AI Si Silber (opsional; kosong = jawaban offline) ----
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
QWEN_API_KEY=
ZAI_API_KEY=
TOGETHER_API_KEY=
SILICON_API_KEY=
CHUTES_API_KEY=
AGNES_API_KEY=
ZEN_API_KEY=
VERCEL_API_KEY=
KIMI_API_KEY=
CLODVIA_ROUTER_API_KEY=
THK_API_KEY=
